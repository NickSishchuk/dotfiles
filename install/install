#!/bin/bash

set -e

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)

# Ensure the dotfiles folder is in the correct location
EXPECTED_PATH="$HOME/.local/share/dotfiles/install"
if [[ "$SCRIPT_DIR" != "$EXPECTED_PATH" ]]; then
  echo "ERROR: This script must be run from $EXPECTED_PATH"
  echo "Current location: $SCRIPT_DIR"
  echo ""
  echo "Please move the dotfiles folder to ~/.local/share/dotfiles and try again"
  exit 1
fi

# Source helpers
source "$SCRIPT_DIR/lib/helpers.sh"
source "$SCRIPT_DIR/lib/backup.sh"

DOTFILES_DIR="$HOME/.local/share/dotfiles"

# Initialize backup session
BACKUP_SESSION=$(init_backup_session)
log_info "Backup session: $BACKUP_SESSION"

# Ensure gum is installed first
ensure_gum

# Authenticate sudo early to cache credentials
sudo -v

FAILED_PACKAGES=()
FAILED_STEPS=()

# Runs a setup-* script. A failure here is logged and remembered, but does not
# abort the rest of the install — one flaky step shouldn't take down steps
# that have nothing to do with it.
run_step() {
  local step_name="$1"
  local script_name="$2"

  if ! bash "$SCRIPT_DIR/$script_name"; then
    log_error "$step_name failed — continuing with remaining steps"
    FAILED_STEPS+=("$step_name")
  fi
}

_installParu() {
  if ! is_installed "base-devel"; then
    log_info "Installing base-devel..."
    sudo pacman --noconfirm -S base-devel
  fi
  if ! is_installed "git"; then
    log_info "Installing git..."
    sudo pacman --noconfirm -S git
  fi

  log_info "Cloning paru from AUR..."
  rm -rf /tmp/paru
  git clone https://aur.archlinux.org/paru.git /tmp/paru
  cd /tmp/paru
  log_info "Building and installing paru (this may take a moment)..."
  makepkg -si --noconfirm
  cd ~
  rm -rf /tmp/paru
  log_success "Paru installed successfully"
}

_installPackages() {
  local packages=()
  local batch_size=15

  while IFS= read -r pkg || [ -n "$pkg" ]; do
    [[ -z "$pkg" || "$pkg" =~ ^# ]] && continue

    if is_installed "${pkg}"; then
      continue
    fi

    packages+=("${pkg}")

    # Install when batch is full
    if [ ${#packages[@]} -ge $batch_size ]; then
      if ! spinner "Installing batch (${#packages[@]} packages)..." \
        paru --noconfirm --needed -S "${packages[@]}" 2>&1; then
        # Retry failed batch one-by-one to identify culprit
        for pkg in "${packages[@]}"; do
          paru --noconfirm --needed -S "${pkg}" &>/dev/null || FAILED_PACKAGES+=("$pkg")
        done
      fi
      packages=()
    fi
  done <"$1"

  # Install remaining packages (tracked the same way, not swallowed with `|| true`)
  if [ ${#packages[@]} -gt 0 ]; then
    if ! spinner "Installing remaining ${#packages[@]} package(s)..." \
      paru --noconfirm --needed -S "${packages[@]}" 2>&1; then
      for pkg in "${packages[@]}"; do
        paru --noconfirm --needed -S "${pkg}" &>/dev/null || FAILED_PACKAGES+=("$pkg")
      done
    fi
  fi
}

clear
log_header "Dotfiles Installation"

START_TIME=$(date +%s)
TOTAL_STEPS=6
CURRENT_STEP=0

if ! is_installed "paru"; then
  CURRENT_STEP=$((CURRENT_STEP + 1))
  log_step "[$CURRENT_STEP/$TOTAL_STEPS] Installing paru AUR helper"
  _installParu
fi

CURRENT_STEP=$((CURRENT_STEP + 1))
log_step "[$CURRENT_STEP/$TOTAL_STEPS] Installing packages"
_installPackages "$SCRIPT_DIR/pkgs.txt"

if [ ${#FAILED_PACKAGES[@]} -gt 0 ]; then
  log_error "Failed to install ${#FAILED_PACKAGES[@]} package(s):"
  for pkg in "${FAILED_PACKAGES[@]}"; do
    log_detail "$pkg"
  done
  log_detail "Install these manually later with: paru -S <package>"
fi

if [ -f "$DOTFILES_DIR/default/.bashrc" ]; then
  backup_file "$HOME/.bashrc" 2>/dev/null || true
  cp "$DOTFILES_DIR/default/.bashrc" "$HOME/.bashrc"
  log_success "Bash configuration installed"
fi

CURRENT_STEP=$((CURRENT_STEP + 1))
log_step "[$CURRENT_STEP/$TOTAL_STEPS] Copying configuration files"
run_step "Copying configuration files" "setup-config"

CURRENT_STEP=$((CURRENT_STEP + 1))
log_step "[$CURRENT_STEP/$TOTAL_STEPS] Hardware based setup"
run_step "Hardware based setup" "setup-by-hardware"

CURRENT_STEP=$((CURRENT_STEP + 1))
log_step "[$CURRENT_STEP/$TOTAL_STEPS] Creating theme symlinks"
run_step "Creating theme symlinks" "setup-theme"

CURRENT_STEP=$((CURRENT_STEP + 1))
log_step "[$CURRENT_STEP/$TOTAL_STEPS] Copying applications to ~/.local/share/applications"
run_step "Copying applications" "setup-applications"

CURRENT_STEP=$((CURRENT_STEP + 1))
log_step "[$CURRENT_STEP/$TOTAL_STEPS] Configuring system"
run_step "Configuring system" "setup-system"

hyprctl reload 2>/dev/null || log_detail "Hyprland not running, skipping reload"

END_TIME=$(date +%s)
TOTAL_TIME=$((END_TIME - START_TIME))
MINUTES=$((TOTAL_TIME / 60))
SECONDS=$((TOTAL_TIME % 60))

clear
log_header "Installation Complete!"
echo
log_success "Installed in ${MINUTES}m ${SECONDS}s"
echo

if [ ${#FAILED_STEPS[@]} -gt 0 ]; then
  log_error "${#FAILED_STEPS[@]} step(s) had errors and were skipped:"
  for step in "${FAILED_STEPS[@]}"; do
    log_detail "$step"
  done
  log_detail "Check the output above, fix manually, and re-run the affected setup script if needed"
  echo
fi

# Load backup info from session file for display
source "$HOME/.local/share/dotfiles/.dotfiles-backup-session"
log_info "Backup saved to: $BACKUP_DIR"
log_info "Restore instructions: cat $RESTORE_FILE"

# Clean up session file
rm -f "$HOME/.local/share/dotfiles/.dotfiles-backup-session"

echo
log_info "Please reboot for all changes to take effect"
echo

gum confirm \
  --prompt.foreground=2 \
  --selected.foreground=15 \
  --selected.background=2 \
  --affirmative="OK" \
  --negative="" \
  "You have to pick Hyprland (uwsm-managed) in your login manager (like sddm, gdm, ly). Otherwise scripts will not be in PATH and will NOT WORK" || true

echo
if ask_yes_no "Reboot now?"; then
  clear
  systemctl reboot --no-wall 2>/dev/null || reboot 2>/dev/null
fi
