#!/bin/bash

set -e

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
source "$SCRIPT_DIR/lib/helpers.sh"
source "$SCRIPT_DIR/lib/backup.sh"
DOTFILES_DIR="$HOME/.local/share/dotfiles"
HYPRLAND_CONF="$HOME/.config/hypr/hyprland.lua"

log_info "Configuring hardware-specific settings..."

# Determine which environment and keybindings to use
if has_nvidia_gpu; then
  ENV_CONF="nvidia-env"
  log_detail "Detected NVIDIA GPU"
else
  ENV_CONF="env"
fi

HARDWARE=$(detect_hardware_type)
if [ "$HARDWARE" = "laptop" ]; then
  spinner "Installing brightnessctl..." paru --noconfirm -S brightnessctl
  KEYBIND_CONF="laptop-keybindings"
  log_detail "Detected laptop hardware"
else
  spinner "Installing ddcutil..." paru --noconfirm -S ddcutil
  KEYBIND_CONF="desktop-keybindings"
  log_detail "Detected desktop hardware"
fi

# hyprland.lua always has one env line and one keybindings line; point them at
# the files for this hardware.
CONF_PREFIX='require("~/.local/share/dotfiles/default/hypr/conf/'
sed -i -E "s#^(require\(\"~/\.local/share/dotfiles/default/hypr/conf/)(nvidia-env|env)(\"\))#\1${ENV_CONF}\3#" "$HYPRLAND_CONF"
sed -i -E "s#^(require\(\"~/\.local/share/dotfiles/default/hypr/conf/)(laptop-keybindings|desktop-keybindings)(\"\))#\1${KEYBIND_CONF}\3#" "$HYPRLAND_CONF"

# sed is a silent no-op if those lines were removed or hand-edited. That would
# mean no env config and no keybindings at all, with zero error, so verify.
if grep -qF "${CONF_PREFIX}${ENV_CONF}\")" "$HYPRLAND_CONF" && grep -qF "${CONF_PREFIX}${KEYBIND_CONF}\")" "$HYPRLAND_CONF"; then
  log_success "Hardware-specific configuration applied"
else
  log_error "Could not find the env/keybindings require() lines in hyprland.lua — env vars and keybindings will NOT load until fixed manually"
fi

# Auto-configure monitors if Hyprland is running
if command -v hyprctl &>/dev/null && hyprctl monitors &>/dev/null; then
  log_info "Detecting monitor configuration..."

  MONITORS_CONF="$HOME/.config/hypr/conf/monitors.lua"
  TEMP_CONF=$(mktemp)

  echo 'hl.env("GDK_SCALE", "1")' > "$TEMP_CONF"
  echo "" >> "$TEMP_CONF"

  # Parse hyprctl output and extract highest mode for each monitor
  hyprctl monitors | awk '
    /^Monitor / {
      if (monitor) printf "hl.monitor({ output = \"%s\", mode = \"%s\", position = \"auto\", scale = 1 })\n", monitor, mode
      monitor = $2
      gsub(/[()]/, "", monitor)
      mode = ""
      max_refresh = 0
    }
    /availableModes:/ {
      in_modes = 1
      modes_line = $0
      sub(/.*availableModes: /, "", modes_line)

      split(modes_line, modes, " ")
      for (i in modes) {
        if (modes[i] ~ /@/) {
          split(modes[i], parts, "@")
          res = parts[1]
          refresh = parts[2]
          sub(/Hz$/, "", refresh)

          if (refresh + 0 > max_refresh) {
            max_refresh = refresh + 0
            mode = modes[i]
            sub(/Hz$/, "", mode)
          }
        }
      }
    }
    END {
      if (monitor && mode) printf "hl.monitor({ output = \"%s\", mode = \"%s\", position = \"auto\", scale = 1 })\n", monitor, mode
    }
  ' >> "$TEMP_CONF"

  # Only update if we got valid output
  if grep -q "^hl.monitor" "$TEMP_CONF"; then
    mv "$TEMP_CONF" "$MONITORS_CONF"
    log_success "Auto-configured monitor"
  else
    rm -f "$TEMP_CONF"
    log_detail "Could not detect monitor resolution, keeping default config"
  fi
else
  log_detail "Hyprland not running yet, keeping default monitor config"
  log_detail "Once you've logged into Hyprland, re-run this to auto-detect: bash ~/.local/share/dotfiles/install/setup-by-hardware"
fi
